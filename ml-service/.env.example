LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LOCAL_LLM_FALLBACK=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120

WHISPER_MODEL_SIZE=base
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Set after first run once the model is cached; skips HuggingFace network checks.
# (Also applies to the Whisper model: process one video online first so it is cached too.)
HF_HUB_OFFLINE=0
SCENE_SIMILARITY_THRESHOLD=0.85
OCR_CONFIDENCE_THRESHOLD=0.60
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# Max retrieval distance (2 - 2*cosine) for a chunk to count as relevant; see scripts/measure_relevance.py
RELEVANCE_MAX_DISTANCE=0.70

# Full path to ffmpeg (e.g. C:\ffmpeg\bin\ffmpeg.exe). Leave empty to use ffmpeg from PATH.
FFMPEG_PATH=
